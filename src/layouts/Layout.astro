---
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../lib/sanity';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: any;
  canonicalUrl?: string;
  keywords?: string[];
  footerSeoText?: string;
  noIndex?: boolean;
}

const { title, description, ogImage, canonicalUrl, keywords, footerSeoText, noIndex } =
  Astro.props;

// 1. Fetching EVERYTHING including the full headerMenu object
const settings = await sanityClient.fetch(`*[_type == "siteSettings"][0]{
  ...,
  ogImage{
    ...,
    asset->{url}
  },
  headerMenu[] {
    label,
    link,
    isButton
  },
  footerMenu[],
  socialLinks[]
}`);

const siteBrand = settings?.businessName || 'Cargo to Pakistan';
const finalTitle = title
  ? `${title} | ${siteBrand}`
  : settings?.title || `${siteBrand} | Logistics Services`;

const finalDesc =
  description ||
  settings?.description ||
  `Professional cargo and shipping services from UAE to Pakistan.`;

const finalKeywords = keywords
  ? keywords.join(', ')
  : settings?.keywords?.join(', ') ||
    'cargo to pakistan, dubai to pakistan cargo, courier services';

const baseDomain = settings?.siteUrl || 'https://cargotopakistan.ae';
const currentCanonical = canonicalUrl || `${baseDomain}${Astro.url.pathname}`;

// Page-specific image takes priority; falls back to the site's default social
// image so every page has a social preview image, not just service/company pages.
const finalOgImage = ogImage
  ? { url: urlFor(ogImage).width(1200).height(630).url(), width: 1200, height: 630 }
  : settings?.ogImage?.asset?.url
    ? { url: settings.ogImage.asset.url }
    : null;
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{finalTitle}</title>
    <meta name="description" content={finalDesc} />
    <meta name="keywords" content={finalKeywords} />
    <link rel="canonical" href={currentCanonical} />

    {
      settings?.siteVerificationCode && (
        <meta name="google-site-verification" content={settings.siteVerificationCode} />
      )
    }
    {
      settings?.semrushCode && (
        <meta name="semrush-site-verification" content={settings.semrushCode} />
      )
    }

    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentCanonical} />
    {
      finalOgImage && (
        <>
          <meta property="og:image" content={finalOgImage.url} />
          {finalOgImage.width && <meta property="og:image:width" content={String(finalOgImage.width)} />}
          {finalOgImage.height && <meta property="og:image:height" content={String(finalOgImage.height)} />}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDesc} />
    {finalOgImage && <meta name="twitter:image" content={finalOgImage.url} />}

    <LocalBusinessSchema settings={settings} />

    {
      settings?.gtmId && (
        <script
          is:inline
          set:html={`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${settings.gtmId}');
      `}
        />
      )
    }

    <slot name="head" />
  </head>

  <body class="bg-white min-h-screen font-sans antialiased overflow-x-hidden flex flex-col">
    {
      settings?.gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${settings.gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }

    <!-- Pass the settings (which contains our menu) to the Header -->
    <Header settings={settings} />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer settings={settings} seoText={footerSeoText} />
    <FloatingActions settings={settings} />
    <SpeedInsights />
  </body>
</html>
